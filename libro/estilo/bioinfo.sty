\RequirePackage[explicit]{titlesec}
\newcommand{\bioADNdeco}{%
  % Doble hélice estilizada que atraviesa la banda
  \foreach \x in {0,0.32,...,17.2}{%
    \pgfmathsetmacro{\ya}{1.05*sin(\x*38)}%
    \pgfmathsetmacro{\yb}{-1.05*sin(\x*38)}%
    \pgfmathtruncatemacro{\k}{mod(round(\x*3.1),4)}%
    \ifcase\k \def\cc{nucA}\or\def\cc{nucC}\or\def\cc{nucG}\else\def\cc{nucT}\fi
    \draw[\cc, line width=1.6pt, opacity=.55] (\x,\ya) -- (\x,\yb);}
  \draw[white, line width=2.2pt, opacity=.85, domain=0:17.2, samples=160,
    smooth] plot (\x,{1.05*sin(\x*38)});
  \draw[azulclaro, line width=2.2pt, opacity=.85, domain=0:17.2, samples=160,
    smooth] plot (\x,{-1.05*sin(\x*38)});}
\newcommand{\biocapitulo}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (NW) at (current page.north west);
    \fill[top color=nocturno, bottom color=azulprofundo]
      (NW) rectangle ([yshift=-10.4cm]current page.north east);
    % rejilla tenue tipo «pantalla de secuenciador»
    \begin{scope}[shift={(NW)}]
      \foreach \i in {0.5,1,...,17}{\draw[white,opacity=.05] (\i,0) -- (\i,-10.4);}
      \foreach \j in {0.5,1,...,10.4}{\draw[white,opacity=.05] (0,-\j) -- (17,-\j);}
      \begin{scope}[shift={(0,-8.2)}] \bioADNdeco \end{scope}
      \node[anchor=north east, font=\lightfont\fontsize{120}{120}\selectfont,
        text=white, opacity=.95, inner sep=0pt] at (15.6,-0.9) {\thechapter};
      \node[anchor=north east, font=\sffamily\bfseries\small, text=amarillo,
        inner sep=0pt] at (15.6,-0.55)
        {\addfontfeatures{LetterSpace=18}MÓDULO};
      \node[anchor=south west, text width=11.4cm, align=left,
        font=\titlefont\fontsize{27}{31}\selectfont, text=white,
        inner sep=0pt] at (2.1,-6.3) {#1};
    \end{scope}
    \fill[amarillo] ([yshift=-10.4cm]current page.north west) rectangle
      ([yshift=-10.55cm,xshift=5.4cm]current page.north west);
  \end{tikzpicture}}
\titleformat{\chapter}[block]{}{}{0pt}{\biocapitulo{#1}}
