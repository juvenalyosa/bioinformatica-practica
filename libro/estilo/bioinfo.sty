    \node[anchor=south west, font=\titlefont\fontsize{30}{34}\selectfont,
      text=white, inner sep=0pt] at ([xshift=2.1cm,yshift=-4.6cm]current page.north west) {#1};
    \fill[amarillo] ([yshift=-6.2cm]current page.north west) rectangle
      ([yshift=-6.35cm,xshift=5.4cm]current page.north west);
  \end{tikzpicture}}
