\begin{MintedVerbatim}[commandchars=\\\{\},codes={\catcode`\$=3\catcode`\^=7\catcode`\_=8\relax}]
\PYG{c+c1}{\PYGZsh{} 1. HMM a partir de un MSA (Stockholm o FASTA alineado)}
hmmbuild\PYG{+w}{ }globinas.hmm\PYG{+w}{ }globinas.sto
\PYG{c+c1}{\PYGZsh{} 2. Buscar el perfil en una base de datos de proteínas}
