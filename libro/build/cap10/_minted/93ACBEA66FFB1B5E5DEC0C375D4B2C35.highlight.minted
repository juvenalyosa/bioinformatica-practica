\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{numpy}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{np}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{ld}\PYG{p}{(}\PYG{n}{h1}\PYG{p}{,} \PYG{n}{h2}\PYG{p}{)}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}D, D\PYGZsq{} y r\PYGZca{}2 entre dos columnas de haplotipos 0/1.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{pA}\PYG{p}{,} \PYG{n}{pB} \PYG{o}{=} \PYG{n}{h1}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{p}{)}\PYG{p}{,} \PYG{n}{h2}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{p}{)}
    \PYG{n}{D} \PYG{o}{=} \PYG{p}{(}\PYG{n}{h1} \PYG{o}{\PYGZam{}} \PYG{n}{h2}\PYG{p}{)}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{p}{)} \PYG{o}{\PYGZhy{}} \PYG{n}{pA} \PYG{o}{*} \PYG{n}{pB}
    \PYG{k}{if} \PYG{n}{D} \PYG{o}{\PYGZgt{}}\PYG{o}{=} \PYG{l+m+mi}{0}\PYG{p}{:}
        \PYG{n}{Dmax} \PYG{o}{=} \PYG{n+nb}{min}\PYG{p}{(}\PYG{n}{pA} \PYG{o}{*} \PYG{p}{(}\PYG{l+m+mi}{1} \PYG{o}{\PYGZhy{}} \PYG{n}{pB}\PYG{p}{)}\PYG{p}{,} \PYG{p}{(}\PYG{l+m+mi}{1} \PYG{o}{\PYGZhy{}} \PYG{n}{pA}\PYG{p}{)} \PYG{o}{*} \PYG{n}{pB}\PYG{p}{)}
    \PYG{k}{else}\PYG{p}{:}
        \PYG{n}{Dmax} \PYG{o}{=} \PYG{n+nb}{min}\PYG{p}{(}\PYG{n}{pA} \PYG{o}{*} \PYG{n}{pB}\PYG{p}{,} \PYG{p}{(}\PYG{l+m+mi}{1} \PYG{o}{\PYGZhy{}} \PYG{n}{pA}\PYG{p}{)} \PYG{o}{*} \PYG{p}{(}\PYG{l+m+mi}{1} \PYG{o}{\PYGZhy{}} \PYG{n}{pB}\PYG{p}{)}\PYG{p}{)}
    \PYG{n}{r2} \PYG{o}{=} \PYG{n}{D} \PYG{o}{*}\PYG{o}{*} \PYG{l+m+mi}{2} \PYG{o}{/} \PYG{p}{(}\PYG{n}{pA} \PYG{o}{*} \PYG{p}{(}\PYG{l+m+mi}{1} \PYG{o}{\PYGZhy{}} \PYG{n}{pA}\PYG{p}{)} \PYG{o}{*} \PYG{n}{pB} \PYG{o}{*} \PYG{p}{(}\PYG{l+m+mi}{1} \PYG{o}{\PYGZhy{}} \PYG{n}{pB}\PYG{p}{)}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{D}\PYG{p}{,} \PYG{n}{D} \PYG{o}{/} \PYG{n}{Dmax}\PYG{p}{,} \PYG{n}{r2}

\PYG{c+c1}{\PYGZsh{} H: matriz (haplotipos x SNP) de 0/1, p. ej., de un VCF faseado}
